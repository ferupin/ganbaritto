      "questions": [
        {
          "type": "multiple_choice",
          "id": "q01",
          "prompt": "Choose the correct form: She ___ to school every day.",
          "options": [
            {
              "id": "a",
              "text": "go"
            },
            {
              "id": "b",
              "text": "goes"
            },
            {
              "id": "c",
              "text": "going"
            },
            {
              "id": "d",
              "text": "gone"
            }
          ],
          "answer": "b",
          "explanation": "Com she, o verbo no presente simples leva -es: goes.",
          "points": 1
        },
        {
          "type": "multiple_choice",
          "id": "q02",
          "prompt": "What is the plural of “child”?",
          "options": [
            {
              "id": "a",
              "text": "childs"
            },
            {
              "id": "b",
              "text": "childes"
            },
            {
              "id": "c",
              "text": "children"
            },
            {
              "id": "d",
              "text": "childrens"
            }
          ],
          "answer": "c",
          "explanation": "“Child” tem plural irregular: children.",
          "points": 1
        },
        {
          "type": "multiple_choice",
          "id": "q03",
          "prompt": "Which sentence is in the Simple Past?",
          "options": [
            {
              "id": "a",
              "text": "I played soccer yesterday."
            },
            {
              "id": "b",
              "text": "I play soccer every day."
            },
            {
              "id": "c",
              "text": "I am playing soccer now."
            },
            {
              "id": "d",
              "text": "I will play soccer tomorrow."
            }
          ],
          "answer": "a",
          "explanation": "“Played” e “yesterday” indicam passado.",
          "points": 1
        },
        {
          "type": "multiple_choice",
          "id": "q04",
          "prompt": "Choose the correct preposition: The book is ___ the table.",
          "options": [
            {
              "id": "a",
              "text": "at"
            },
            {
              "id": "b",
              "text": "with"
            },
            {
              "id": "c",
              "text": "of"
            },
            {
              "id": "d",
              "text": "on"
            }
          ],
          "answer": "d",
          "explanation": "Usamos “on” para algo apoiado sobre uma superfície.",
          "points": 1
        },
        {
          "type": "multiple_choice",
          "id": "q05",
          "prompt": "Read the sentences and choose the right option.",
          "statements": [
            "There are three books on the desk.",
            "There is three books on the desk.",
            "They are my friends."
          ],
          "options": [
            {
              "id": "a",
              "text": "Only I and II are correct."
            },
            {
              "id": "b",
              "text": "Only I and III are correct."
            },
            {
              "id": "c",
              "text": "Only II and III are correct."
            },
            {
              "id": "d",
              "text": "I, II and III are correct."
            }
          ],
          "answer": "b",
          "explanation": "“There are” é usado com plural (three books). A frase II está errada.",
          "points": 1
        }
      ]
    },
