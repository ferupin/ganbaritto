  "parts": [
    {
      "id": "parte-1",
      "title": "Números e álgebra",
      "questions": [
        {
          "type": "multiple_choice",
          "id": "q01",
          "prompt": "Qual é o valor de $2^5$?",
          "options": [
            {
              "id": "a",
              "text": "32"
            },
            {
              "id": "b",
              "text": "10"
            },
            {
              "id": "c",
              "text": "25"
            },
            {
              "id": "d",
              "text": "64"
            }
          ],
          "answer": "a",
          "explanation": "$2^5 = 2 \\times 2 \\times 2 \\times 2 \\times 2 = 32$.",
          "points": 1
        },
        {
          "type": "multiple_choice",
          "id": "q02",
          "prompt": "Resolva $3x + 5 = 20$. Qual é o valor de $x$?",
          "options": [
            {
              "id": "a",
              "text": "3"
            },
            {
              "id": "b",
              "text": "15"
            },
            {
              "id": "c",
              "text": "25"
            },
            {
              "id": "d",
              "text": "5"
            }
          ],
          "answer": "d",
          "explanation": "$3x = 20 - 5 = 15$, então $x = 15 \\div 3 = 5$.",
          "points": 1
        },
        {
          "type": "multiple_choice",
          "id": "q03",
          "prompt": "O número 4.500 em notação científica é:",
          "options": [
            {
              "id": "a",
              "text": "$4{,}5 \\times 10^2$"
            },
            {
              "id": "b",
              "text": "$45 \\times 10^3$"
            },
            {
              "id": "c",
              "text": "$4{,}5 \\times 10^3$"
            },
            {
              "id": "d",
              "text": "$4{,}5 \\times 10^4$"
            }
          ],
          "answer": "c",
          "explanation": "$4500 = 4{,}5 \\times 1000 = 4{,}5 \\times 10^3$.",
          "points": 1
        },
        {
          "type": "multiple_choice",
          "id": "q04",
          "prompt": "Analise as afirmativas:",
          "statements": [
            "$\\sqrt{49} = 7$",
            "$(-3)^2 = -9$",
            "$10^0 = 1$"
          ],
          "options": [
            {
              "id": "a",
              "text": "Apenas I e II estão corretas"
            },
            {
              "id": "b",
              "text": "Apenas I e III estão corretas"
            },
            {
              "id": "c",
              "text": "Apenas II e III estão corretas"
            },
            {
              "id": "d",
              "text": "I, II e III estão corretas"
            }
          ],
          "answer": "b",
          "explanation": "$\\sqrt{49} = 7$ e $10^0 = 1$. Já $(-3)^2 = +9$, e não $-9$.",
          "points": 1
        },
        {
          "type": "multiple_choice",
          "id": "q05",
          "prompt": "Uma camiseta de R$ 80,00 tem 25% de desconto. Qual é o preço final?",
          "options": [
            {
              "id": "a",
              "text": "R$ 55,00"
            },
            {
              "id": "b",
              "text": "R$ 60,00"
            },
            {
              "id": "c",
              "text": "R$ 65,00"
            },
            {
              "id": "d",
              "text": "R$ 75,00"
            }
          ],
          "answer": "b",
          "explanation": "25% de 80 = 20. Então 80 − 20 = 60.",
          "points": 1
        }
      ]
    },
    {
      "id": "parte-2",
      "title": "Geometria, dados e probabilidade",
      "questions": [
        {
          "type": "multiple_choice",
          "id": "q06",
          "prompt": "Em um triângulo retângulo, os catetos medem 3 cm e 4 cm. A hipotenusa mede:",
          "options": [
            {
              "id": "a",
              "text": "7 cm"
            },
            {
              "id": "b",
              "text": "6 cm"
            },
            {
              "id": "c",
              "text": "12 cm"
            },
            {
              "id": "d",
              "text": "5 cm"
            }
          ],
          "answer": "d",
          "explanation": "Pelo teorema de Pitágoras: $3^2 + 4^2 = 9 + 16 = 25$, e $\\sqrt{25} = 5$.",
          "points": 1
        },
        {
          "type": "multiple_choice",
          "id": "q07",
          "prompt": "A soma dos ângulos internos de um triângulo é:",
          "options": [
            {
              "id": "a",
              "text": "180°"
            },
            {
              "id": "b",
              "text": "90°"
            },
            {
              "id": "c",
              "text": "270°"
            },
            {
              "id": "d",
              "text": "360°"
            }
          ],
          "answer": "a",
          "explanation": "Em qualquer triângulo, os ângulos internos somam 180°.",
          "points": 1
        },
        {
          "type": "multiple_choice",
          "id": "q08",
          "prompt": "Em um dado comum, qual é a probabilidade de sair um número par?",
          "options": [
            {
              "id": "a",
              "text": "$\\frac{1}{3}$"
            },
            {
              "id": "b",
              "text": "$\\frac{1}{6}$"
            },
            {
              "id": "c",
              "text": "$\\frac{1}{2}$"
            },
            {
              "id": "d",
              "text": "$\\frac{2}{3}$"
            }
          ],
          "answer": "c",
          "explanation": "Há 3 pares (2, 4, 6) em 6 faces: $\\frac{3}{6} = \\frac{1}{2}$.",
          "points": 1
        },
        {
          "type": "multiple_choice",
